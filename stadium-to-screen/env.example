# Copy to .env for local dev (never commit the real .env)

# --- core ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/your-hook-id
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
ADMIN_TOKEN=choose-a-long-random-string
ALLOWED_ORIGIN=*          # set to https://smart1marketing.com to lock down

# --- speed-to-lead (all optional; skipped gracefully if unset) ---
NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/xxx   # instant rep ping (Slack/generic)
SMTP_URL=smtp://user:pass@smtp.host.com:587               # auto-email prospect their PDF
MAIL_FROM=Smart 1 Marketing <no-reply@smart1marketing.com>

# --- strategist block on the PDF / "Book a strategy call" button ---
REP_NAME=Alex Carter
REP_EMAIL=alex@smart1marketing.com
REP_PHONE=(614) 555-0199
CALENDAR_URL=https://api.leadconnectorhq.com/widget/booking/your-calendar

PORT=3000                 # Render sets this automatically — do not set on Render
